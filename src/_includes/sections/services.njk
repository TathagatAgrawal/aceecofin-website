{%- set s = copy.services -%}
<section id="{{ s.id or 'services' }}" class="section" aria-labelledby="h-services">
  <div class="col">
    <h2 class="section__heading" id="h-services">{{ s.heading }}</h2>
    {%- if s.body %}<div class="prose">{{ s.body | md | safe }}</div>{% endif %}

    {%- for svc in s.services %}
    <div class="service"{% if svc.id %} id="{{ svc.id }}"{% endif %}>
      <h3 class="service__title">{{ svc.title }}</h3>
      {%- if svc.intro %}<p class="service__intro">{{ svc.intro | mdInline | safe }}</p>{% endif %}

      {%- if svc.items and svc.items.length %}
      <ul class="list">
        {%- for item in svc.items %}<li>{{ item | mdInline | safe }}</li>{% endfor %}
      </ul>
      {%- endif %}

      {%- for g in svc.groups %}
      <h4 class="service__group">{{ g.title }}</h4>
      <ul class="list">
        {%- for item in g.items %}<li>{{ item | mdInline | safe }}</li>{% endfor %}
      </ul>
      {%- endfor %}

      {%- if svc.software and svc.software.items.length %}
      <p class="software"><span class="software__label">{{ svc.software.label }}</span> {{ svc.software.items | join(" · ") }}</p>
      {%- endif %}
    </div>
    {%- endfor %}
  </div>
</section>
