{%- import "icons.njk" as icons -%}
{%- set s = copy.hero -%}
<section id="top" class="hero">
  <div class="wrap hero__inner">
    {%- if s.eyebrow %}<p class="eyebrow eyebrow--on-dark">{{ s.eyebrow }}</p>{% endif %}
    <h1 class="hero__title">{{ s.heading }}</h1>
    {%- if s.body %}
    <div class="hero__lead">{{ s.body | md | safe }}</div>
    {%- endif %}
    {%- if s.buttons and s.buttons.length %}
    <div class="btn-row">
      {%- for b in s.buttons %}
      <a class="btn btn--lg {{ 'btn--ghost-dark' if b.style == 'ghost' else 'btn--primary' }}" href="{{ b.href }}">{{ b.label }}</a>
      {%- endfor %}
    </div>
    {%- endif %}
    {%- if s.trust_points and s.trust_points.length %}
    <ul class="trust-list">
      {%- for t in s.trust_points %}
      <li>{{ icons.icon("check", 18) | safe }}<span>{{ t | mdInline | safe }}</span></li>
      {%- endfor %}
    </ul>
    {%- endif %}
  </div>
</section>
