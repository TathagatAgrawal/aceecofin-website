{%- set s = copy.contact -%}
{%- set c = site.contact -%}
<section id="{{ s.id or 'contact' }}" class="section" aria-labelledby="h-contact">
  <div class="col">
    <h2 class="section__heading" id="h-contact">{{ s.heading }}</h2>
    {%- if s.body %}<div class="prose">{{ s.body | md | safe }}</div>{% endif %}
    <dl class="details">
      {%- if c.email %}
      <div><dt>{{ s.labels.email }}</dt><dd><a href="mailto:{{ c.email }}">{{ c.email }}</a></dd></div>
      {%- endif %}
      {%- if c.linkedin %}
      <div><dt>{{ s.labels.linkedin }}</dt><dd><a href="{{ c.linkedin }}" target="_blank" rel="noopener">{{ site.name }} on LinkedIn</a></dd></div>
      {%- endif %}
      {%- if c.website %}
      <div><dt>{{ s.labels.website }}</dt><dd><a href="/">{{ c.website }}</a></dd></div>
      {%- endif %}
    </dl>
  </div>
</section>
