{#- Shared body for simple pages such as the 404. Expects `p` = a content file. -#}
<section class="section section--first">
  <div class="col">
    <h1 class="intro__title">{{ p.heading }}</h1>
    <div class="prose">{{ p.body | md | safe }}</div>
    {%- if p.button %}
    <p><a class="link-button" href="{{ p.button.href }}">{{ p.button.label }}</a></p>
    {%- endif %}
  </div>
</section>
