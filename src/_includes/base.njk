<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle = (title ~ " | " ~ site.name) if title else site.seo.title %}
{%- set canonical = site.url ~ page.url %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ site.seo.description }}">
<link rel="canonical" href="{{ canonical }}">
{%- if noindex %}
<meta name="robots" content="noindex">
{%- endif %}

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ site.seo.description }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ site.url }}{{ site.seo.og_image }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">

<link rel="icon" type="image/png" sizes="48x48" href="/assets/img/favicon-48.png">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<meta name="theme-color" content="#0B1F3A">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap">
<link rel="stylesheet" href="/assets/css/styles.css">

{%- set ld = {
  "@context": "https://schema.org",
  "@type": "AccountingService",
  "name": site.name,
  "description": site.seo.description,
  "url": site.url,
  "logo": site.url ~ site.logo.mark,
  "image": site.url ~ site.seo.og_image,
  "email": site.contact.email,
  "areaServed": ["US", "GB", "CA", "AU", "AE", "IN"],
  "address": { "@type": "PostalAddress", "addressRegion": site.location, "addressCountry": "IN" }
} %}
<script type="application/ld+json">{{ ld | dump | safe }}</script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/#top" aria-label="{{ site.name }}, home">
      <img class="brand__mark" src="{{ site.logo.mark }}" alt="" width="70" height="66">
      <span class="brand__name">{{ site.name }}</span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {%- for item in site.menu %}
        <li><a href="/{{ item.href }}">{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
    <a class="btn btn--primary site-header__cta" href="/{{ site.menu_button.href }}">{{ site.menu_button.label }}</a>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <p><span class="site-footer__name">{{ site.name }}</span> · {{ site.footer.descriptor }} · {{ site.location }}</p>
    <p>© {{ year }} {{ site.name }}. {{ site.footer.rights }}</p>
  </div>
</footer>
</body>
</html>
